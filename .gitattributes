# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Go and build scripts
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.syso binary
*.zip binary
*.tar.gz binary
